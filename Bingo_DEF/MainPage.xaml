<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Bingo_DEF.MainPage"
             BackgroundColor="#0F1123">

    <Grid Padding="20" ColumnSpacing="20" RowSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <VerticalStackLayout Grid.Column="0" Spacing="15">
            <Border StrokeShape="RoundRectangle 20" BackgroundColor="#1A1D3D" Padding="20">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                    <Label Text="NÚMERO ACTUAL" TextColor="#7B81B1" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Border WidthRequest="160" HeightRequest="160" StrokeShape="RoundRectangle 80" BackgroundColor="White">
                        <Label x:Name="CurrentNumberLabel" Text="--" FontSize="90" TextColor="#0F1123" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label x:Name="BallCounterLabel" Text="Bolas: 0/90" TextColor="#00A3FF" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 20" BackgroundColor="#272B51" Padding="15" HeightRequest="100">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="AVISOS RECIENTES" TextColor="#00A3FF" FontSize="12" HorizontalOptions="Center" FontAttributes="Bold"/>
                    <Label x:Name="NotificationLabel" Text="Esperando avisos..." TextColor="White" FontSize="16" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,5,0,0"/>
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 20" BackgroundColor="#1A1D3D" Padding="15">
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                    <Button Grid.Row="0" Grid.Column="0" Text="INICIAR" BackgroundColor="#00D27B" Clicked="OnStartClicked" FontAttributes="Bold" TextColor="White"/>
                    <Button Grid.Row="0" Grid.Column="1" Text="PAUSA" BackgroundColor="#00A3FF" Clicked="OnPauseClicked" FontAttributes="Bold" TextColor="White"/>
                    <Button Grid.Row="0" Grid.Column="2" Text="RESET" BackgroundColor="#FF4B4B" Clicked="OnReiniciarClicked" FontAttributes="Bold" TextColor="White"/>

                    <Button x:Name="BtnVel1" Grid.Row="1" Grid.Column="0" Text="x1" Clicked="SetVel1" BackgroundColor="#2D3265" TextColor="White"/>
                    <Button x:Name="BtnVel1_5" Grid.Row="1" Grid.Column="1" Text="x1.5" Clicked="SetVel1_5" BackgroundColor="#2D3265" TextColor="White"/>
                    <Button x:Name="BtnVel2" Grid.Row="1" Grid.Column="2" Text="x2" Clicked="SetVel2" BackgroundColor="#2D3265" TextColor="White"/>
                </Grid>
            </Border>

            <Border StrokeShape="RoundRectangle 20" BackgroundColor="#1A1D3D" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Picker x:Name="VoicePicker" Title="Voz del Cantor" TextColor="White" BackgroundColor="#2D3265" TitleColor="#7B81B1"/>
                    <Button Text="GENERAR QR" Clicked="OnGenerateQRClicked" BackgroundColor="#C648FF" FontAttributes="Bold" TextColor="White"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Column="1" Spacing="15">
            <Border StrokeShape="RoundRectangle 25" BackgroundColor="#1A1D3D" Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Label Text="TABLERO GENERAL" TextColor="White" FontSize="22" HorizontalOptions="Center" FontAttributes="Bold"/>
                    <Grid x:Name="BingoBoardGrid" RowDefinitions="*,*,*,*,*,*,*,*,*" ColumnDefinitions="*,*,*,*,*,*,*,*,*,*" ColumnSpacing="6" RowSpacing="6" HeightRequest="500" />
                </VerticalStackLayout>
            </Border>
            <Border StrokeShape="RoundRectangle 15" BackgroundColor="#0B0D1A" HeightRequest="80" Padding="10">
                <HorizontalStackLayout x:Name="BallHistoryContainer" Spacing="10" HorizontalOptions="Center"/>
            </Border>
        </VerticalStackLayout>

        <Grid x:Name="QRModal" IsVisible="False" Grid.ColumnSpan="2" BackgroundColor="#CC000000">
            <Border BackgroundColor="White" Padding="30" HorizontalOptions="Center" VerticalOptions="Center" StrokeShape="RoundRectangle 30">
                <VerticalStackLayout Spacing="20">
                    <Image x:Name="QRCodeImage" WidthRequest="300" HeightRequest="300"/>
                    <Button Text="CERRAR" Clicked="OnCloseQRClicked" BackgroundColor="#0F1123" TextColor="White"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>